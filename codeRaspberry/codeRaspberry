import time
import machine
import network
import urequests as requests
from config_manager import load_config, clear_config, valid
from wifi_setup import start_ap, start_webserver
from machine import Pin

# ==== GPIO ====
led_green = Pin(2, Pin.OUT)
led_red   = Pin(3, Pin.OUT)

bcd_pins   = [Pin(n, Pin.OUT) for n in (4,5,6,7)]
blank_tens  = Pin(8, Pin.OUT, value=0)  # par défaut LOW = off
blank_units = Pin(9, Pin.OUT, value=0)


btn_free     = Pin(14, Pin.IN, Pin.PULL_DOWN)
btn_reserved = Pin(15, Pin.IN, Pin.PULL_DOWN)

# ==== Affichage multiplexé pour PNP high-side ====

def drive_digit(val, blank_pin):
    # place les bits BCD
    for i, p in enumerate(bcd_pins):
        p.value((val >> i) & 1)
    # ACTIVER le transistor high-side (PNP) par HIGH
    blank_pin.value(1)
    time.sleep_us(500)   # 0.5 ms d’allumage
    # COUPER par LOW
    blank_pin.value(0)

def multiplex(table, duration_ms=100):
    tens  = table // 10
    units = table % 10
    end = time.ticks_add(time.ticks_ms(), duration_ms)
    while time.ticks_diff(end, time.ticks_ms()) > 0:
        # Toujours afficher la dizaine, même si val == 0
        drive_digit(tens, blank_tens)

        # Puis l’unité
        drive_digit(units, blank_units)

def leds_et_afficheur(table, state):
    led_green.value(1 if state == 'free' else 0)
    led_red.value(1 if state == 'reserved' else 0)
    multiplex(table, duration_ms=100)

# ==== Réseau ====
def send_state(api, table, state):
    try:
        r = requests.post(api.rstrip('/') + '/state',
                          json={'table': table, 'state': state})
        r.close()
    except Exception as e:
        print("POST error:", e)

def connect_wifi(ssid, pwd, timeout=15):
    wlan = network.WLAN(network.STA_IF)
    wlan.active(True)
    wlan.connect(ssid, pwd)
    for _ in range(timeout):
        if wlan.isconnected():
            print("Wi-Fi OK:", wlan.ifconfig()[0])
            return True
        time.sleep(1)
    return False

# ==== Programme principal ====
def main():
    if not valid():
        clear_config()
        print("⚠️ Config incomplète, démarrage AP")
        start_ap()
        start_webserver()
        return

    cfg = load_config()
    if not connect_wifi(cfg['ssid'], cfg['password']):
        print("🔴 Wi-Fi fail, reset")
        clear_config()
        machine.reset()
        return

    api = cfg['apiUrl']
    print("✅ API_URL =", api)

    last_table = -1
    last_state = ''
    prev_free = 0
    prev_reserved = 0

    while True:
        # Lecture des boutons
        curr_free     = btn_free.value()
        curr_reserved = btn_reserved.value()

        # Détection d'un appui (front montant)
        if curr_free and not prev_free:
            send_state(api, last_table, 'free')
        if curr_reserved and not prev_reserved:
            send_state(api, last_table, 'reserved')

        prev_free     = curr_free
        prev_reserved = curr_reserved

        # Récupération du status depuis l’API
        try:
            r = requests.get(api.rstrip('/') + '/status')
            if r.status_code == 200:
                d = r.json()
                table = int(d.get('table', 0))
                state = d.get('state', 'free')
                if (table, state) != (last_table, last_state):
                    print("Status:", d)
                    last_table, last_state = table, state
            else:
                print("Status HTTP", r.status_code)
            r.close()
        except Exception as e:
            print("HTTP error:", e)

        # Mise à jour du hard­ware
        leds_et_afficheur(last_table, last_state)

        # Un petit délai pour debouncer + pas spammer l’API
        time.sleep(0.1)

if __name__ == '__main__':
    main()

