# BCD pins
bcd = [Pin(n, Pin.OUT) for n in (4,5,6,7)]
# Transistors PNP pilotant les anodes
tens  = Pin(8, Pin.OUT)
units = Pin(9, Pin.OUT)

def show_digit(val, sel):
    # place BCD
    for i,p in enumerate(bcd):
        p.value((val>>i)&1)
    # active ce digit
    sel.value(1)
    time.sleep_ms(5)
    sel.value(0)

while True:
    # afficher 0 sur tens, 6 sur units
    show_digit(6, tens)
    show_digit(9, units)


